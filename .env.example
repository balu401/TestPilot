# TestPilot Environment Configuration

# Google Gemini API key used to access hosted Gemma models (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma model identifier (supported on Gemini API: gemma-2-9b-it, gemma-2-27b-it, or custom fine-tune)
GEMMA_MODEL=gemma-2-9b-it

# Optional: Local Ollama URL if running open-weights models offline (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
